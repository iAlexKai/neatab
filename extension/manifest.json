{
  "manifest_version": 3,
  "name": "Seven · 最近标签切换",
  "version": "1.3.0",
  "description": "Option+Tab 切换最近 7 个标签页，Command+Shift+C 复制当前网页链接，一键关闭 12 小时未访问的标签页。适用于 macOS Chrome，搭配 Seven 辅助程序。",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Seven · 最近 7 个标签页"
  },
  "icons": {
    "128": "icon128.png"
  },
  "incognito": "not_allowed"
}
